"
An abstract data store to be used on `GtkListView`, `GtkDropDown`, etc.
"
Class {
	#name : 'GBaseListStore',
	#superclass : 'GObject',
	#traits : 'GLibTLibrary + GTListModel',
	#classTraits : 'GLibTLibrary classTrait + GTListModel classTrait',
	#category : 'GLib-Lists',
	#package : 'GLib',
	#tag : 'Lists'
}
